{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "coverage/**",
    "vendor/**"
  ],
  "tags": [
    "-lintignore"
  ],
  "entry": [
    "scripts/*.ts",
    "src/fitting/fit.worker.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "duplicates"
  ],
  "ignoreBinaries": [
    "tools/build-verovio.sh"
  ]
}
